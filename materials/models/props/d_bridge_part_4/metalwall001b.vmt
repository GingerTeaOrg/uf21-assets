// envmaptint_fix
"vertexlitgeneric"
{
	"$basetexture" "metal/metalwall001b"
	"$surfaceprop"  "metal"
	"$detail" "detail\metal_detail_01"
	"$detailscale" "4.283"
	"$detailblendfactor" .8
	"$detailblendmode" "0"

	"%keywords" "c17industrial"
	"$bumpmap" "metal/metalwall001b_normal"

	"vertexlitgeneric_dx9"
	{
		"$envmaptint" "[ .56 .56 .56 ]"
		"$envmap" "env_cubemap"
		"$normalmapalphaenvmapmask" 1
		"$envmapcontrast" 1
		"$envmapsaturation" 1
	}
}
