"UnLitGeneric"
{

	"$color"				"[1 1 1]"
	"$baseTexture"				"models/props_foliage/tree_card_clump"
	"$selfIllum"				0
	"$translucent"				1
	"$alpha"				1
	"$nocull"				1
	"$model"				1

	"$texscale"	4
	"$baseTextureOffset" "[0.5 0.5]"
	"Proxies"
     	{
	"TextureTransform"
            {
		"translateVar" "$baseTextureOffset"
		"scaleVar"     "$texscale"
		"resultVar"    "$baseTextureTransform"
            }
     	}
}
